# ── Anthropic (script + metadata generation) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model for script/metadata. Default is the most capable Opus. For a high-volume
# faceless pipeline you can trade quality for cost by switching to:
#   claude-sonnet-5   (cheaper, still strong)   or   claude-haiku-4-5 (cheapest)
CLAUDE_MODEL=claude-opus-5

# ── ElevenLabs (voiceover) ───────────────────────────────────────────────
ELEVENLABS_API_KEY=
# A warm, storyteller-style voice. Browse voices at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Image generation (pluggable — see scripts/generate_images.py) ─────────
# Point these at whatever image API you use (Flux host, SD host, DALL·E, etc.)
IMAGE_API_URL=
IMAGE_API_KEY=
# Style suffix appended to every scene image prompt to keep a consistent look.
IMAGE_STYLE="soft 3D animated children's storybook style, warm pastel colors, gentle rounded shapes, cozy lighting, no text"

# ── Video assembly ───────────────────────────────────────────────────────
# Optional background music track (royalty-free). Leave blank for no music.
BG_MUSIC_PATH=
# 9:16 vertical for Shorts.
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# ── YouTube ──────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN=token.json
